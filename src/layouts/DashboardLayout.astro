---
// Shell privado (HU-01): sidebar + perfil + logout + topbar.
// La verificación de sesión ocurre en el middleware SSR; aquí ya hay `locals.user`.
import '../styles/global.css';
import LogoutButton from '../components/islands/LogoutButton.tsx';
import MobileNav from '../components/islands/MobileNav.tsx';

interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
const pathname = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Dashboard' },
  { href: '/insumos', label: 'Insumos' },
  { href: '/recetas', label: 'Recetas' },
  // "Ventas" es ahora el resumen (lo que mira el negocio); las cuentas de POS
  // son plomería de administración y pasan a llamarse por lo que son.
  { href: '/ventas', label: 'Ventas' },
  // El mapeo es tarea de catálogo (la hace quien conoce la carta), así que va
  // junto al resumen y no con la plomería de administración.
  { href: '/ventas/mapeo', label: 'Mapeo de ítems' },
  { href: '/ventas/cuentas', label: 'Cuentas de venta' },
  { href: '/ventas/conciliacion', label: 'Conciliación' },
];

// Activo = el enlace MÁS ESPECÍFICO que cubre la ruta actual. Sin esa segunda
// condición, "/ventas" y "/ventas/mapeo" se marcarían los dos a la vez, porque
// el primero es prefijo del segundo; con tres páginas bajo /ventas ya se nota.
const cubre = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');

const hrefActivo = nav
  .map((item) => item.href)
  .filter(cubre)
  .sort((a, b) => b.length - a.length)[0];

function isActive(href: string) {
  return href === hrefActivo;
}

const initials = (user?.email ?? '?').slice(0, 2).toUpperCase();
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Kumobi</title>
  </head>
  <body class="min-h-screen bg-app text-text-base">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside
        class="hidden w-64 shrink-0 flex-col border-r border-border-base bg-surface lg:flex"
      >
        <div class="flex h-14 items-center gap-2 border-b border-border-base px-5">
          <span class="text-lg font-semibold text-text-strong">Kumobi</span>
        </div>
        <nav class="flex-1 space-y-1 p-3" aria-label="Navegación principal">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class={`flex items-center gap-2 rounded-md border-l-2 px-3 py-2 text-sm font-medium ${
                  isActive(item.href)
                    ? 'border-primary bg-primary-soft text-primary'
                    : 'border-transparent text-text-base hover:bg-app'
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="border-t border-border-base p-3">
          <div class="mb-2 flex items-center gap-2">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-soft text-xs font-semibold text-primary"
              aria-hidden="true"
            >
              {initials}
            </span>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-text-strong">
                {user?.email ?? 'Usuario'}
              </p>
              <p class="text-xs capitalize text-text-muted">{user?.role ?? 'sin rol'}</p>
            </div>
          </div>
          <LogoutButton client:load />
        </div>
      </aside>

      <!-- Contenido -->
      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex h-14 items-center justify-between border-b border-border-base bg-surface px-4 sm:px-6"
        >
          <div class="flex items-center gap-3">
            <div class="lg:hidden">
              <MobileNav
                client:load
                items={nav}
                pathname={pathname}
                email={user?.email ?? ''}
                role={user?.role ?? ''}
              />
            </div>
            <span class="text-sm font-semibold text-text-strong lg:hidden">Kumobi</span>
            <p class="hidden text-sm font-medium text-text-muted lg:block">{title}</p>
          </div>
        </header>
        <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
